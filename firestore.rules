rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSubscription(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.status is string &&
             data.status.size() <= 32 &&
             data.isVerified is bool;
    }

    function isValidTelemetry(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.timestamp is number &&
             data.level is number &&
             data.level >= 0 && data.level <= 100 &&
             data.state is string &&
             data.state.size() <= 32;
    }

    // User Subscriptions: only readable and writable by the authenticated owner
    match /users/{userId}/subscription/{subscriptionId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(subscriptionId) && isValidSubscription(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // User Telemetry Backups: only readable and writable by the authenticated owner
    match /users/{userId}/telemetry/{telemetryId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(telemetryId) && isValidTelemetry(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }
  }
}
